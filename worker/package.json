{
  "name": "@open-observe/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker for open-observe: OTLP/JSON ingest, scrubbing, D1 storage, read API and dashboard hosting",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run --testTimeout=60000",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply open-observe --local",
    "db:migrate": "wrangler d1 migrations apply open-observe --remote"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.5",
    "@cloudflare/workers-types": "5.20261019.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.151.2"
  }
}
